# Appwrite Configuration (Free — no credit card required)
# Copy this file to .env and fill in your Appwrite project values.
# DO NOT commit .env to version control.

# Appwrite Cloud (free tier: 75K MAU, 10GB storage)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_DATABASE_ID=your-database-id

# Or self-hosted
# APPWRITE_ENDPOINT=http://localhost:80/v1
# APPWRITE_PROJECT_ID=your-project-id

# API Keys (for AI processing — optional for MVP)
OPENAI_API_KEY=your-openai-api-key
BACKEND_API_URL=https://api.your-backend.com/v1
