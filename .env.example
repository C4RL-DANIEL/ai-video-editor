# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values.
# DO NOT commit .env to version control.

FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Android
FIREBASE_ANDROID_PACKAGE_NAME=com.aivideoeditor.app

# iOS
FIREBASE_IOS_BUNDLE_ID=com.aivideoeditor.app

# API Keys (for AI services)
OPENAI_API_KEY=your-openai-api-key
BACKEND_API_URL=https://api.your-backend.com/v1
