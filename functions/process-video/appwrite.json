{
  "functions": [
    {
      "key": "process-video",
      "name": "Process Video",
      "runtime": "node-18.0",
      "path": ".",
      "entrypoint": "src/index.js",
      "timeout": 300,
      "execute": ["any"],
      "events": [
        "storage.files.create",
        "storage.files.update"
      ],
      "variables": [
        {
          "key": "APPWRITE_ENDPOINT",
          "value": "https://sgp.cloud.appwrite.io/v1"
        },
        {
          "key": "APPWRITE_PROJECT_ID",
          "value": "6aa6c23100337d473370"
        },
        {
          "key": "VIDEOS_BUCKET_ID",
          "value": "videos"
        },
        {
          "key": "APPWRITE_API_KEY",
          "value": ""
        }
      ]
    }
  ]
}